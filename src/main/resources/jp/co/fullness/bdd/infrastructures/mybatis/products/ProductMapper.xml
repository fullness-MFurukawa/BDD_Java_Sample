<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.co.fullness.bdd.infrastructures.mybatis.products.ProductMapper">
    <resultMap id="productResult" type="ProductTableModel">
        <id property="id" column="id" />
        <result property="objId" column="obj_id" />
        <result property="name" column="name" />
        <result property="price" column="price" />
        <association property="category" javaType="CategoryTableModel">
            <id property="id" column="category_pk" />
            <result property="objId" column="category_id" />
            <result property="name" column="category_name" />
        </association>
    </resultMap>

    <!-- findById()メソッド用SQLの定義 -->
    <select id="findById" resultType="ProductTableModel">
        <![CDATA[
            SELECT id , obj_id As objId, name  , price
            FROM product
            WHERE obj_id = #{productId}
        ]]>
    </select>
    <!-- findByNameContains()メソッド用SQLの定義 -->
    <select id="findByNameContains" resultMap="productResult">
        <bind name="partialName" value="'%'+_parameter+'%'" />
        <![CDATA[
            SELECT p.id , p.obj_id , p.name , p.price ,
            c.id AS category_pk ,c.obj_id AS category_id, c.name AS category_name
            FROM product p JOIN category c
            ON p.category_id = c.id
            WHERE p.name LIKE #{partialName}
            ORDER BY p.id
        ]]>
    </select>
    <!-- exists()メソッド用SQLの定義 -->
    <select id="exists" resultType="Boolean">
        <![CDATA[
            SELECT EXISTS (
                SELECT 1
                FROM product
                WHERE name = #{productName}
            ) AS ProductExists;
        ]]>
    </select>
    <!-- create()メソッド用SQLの定義 -->
    <insert id="create" parameterType="ProductTableModel">
        <selectKey keyProperty="id" resultType="int" order="BEFORE">
            <![CDATA[ SELECT nextval('product_seq') ]]>
        </selectKey>
        <![CDATA[
            INSERT INTO product
            VALUES (#{id} , #{objId} , #{name} , #{price} ,
            (SELECT id FROM category WHERE obj_id = #{category.objId}))
        ]]>
    </insert>
    <!-- updateByIdメソッド用SQLの定義 -->
    <update id="updateById" parameterType="ProductTableModel">
        <![CDATA[
            UPDATE product
            SET name = #{name} , price = #{price}
            WHERE obj_id = #{objId}
        ]]>
    </update>
    <!-- deleteByIdメソッド用SQLの定義 -->
    <delete id="deleteById" parameterType="String">
        <![CDATA[
            DELETE FROM product
            WHERE obj_id = #{objId}
        ]]>
    </delete>
</mapper>